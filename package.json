{
  "name": "mcp-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "A zero-trust security and governance gateway for Model Context Protocol deployments.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "servers/demo/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gateway": "node --enable-source-maps apps/gateway/dist/index.js",
    "gateway:demo": "node --enable-source-maps apps/gateway/dist/index.js sentinel.config.example.json",
    "conformance": "node scripts/conformance.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
